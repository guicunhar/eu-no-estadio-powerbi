{
  "name": "Fluminense Tricolor",
  "dataColors": [
    "#7A0C2E",
    "#00613C",
    "#C9A227",
    "#A9A4A0",
    "#C27A8E",
    "#4FA37C",
    "#E2C45F",
    "#D8B4C0",
    "#9CC9B1",
    "#A8445F",
    "#2E8B62",
    "#B7A99E"
  ],
  "foreground": "#231C1F",
  "foregroundNeutralSecondary": "#6E6468",
  "foregroundNeutralTertiary": "#B5ACA7",
  "background": "#FFFFFF",
  "backgroundLight": "#F8F4F1",
  "backgroundNeutral": "#E3DCD4",
  "tableAccent": "#7A0C2E",
  "good": "#00613C",
  "neutral": "#837C77",
  "bad": "#7A0C2E",
  "maximum": "#7A0C2E",
  "center": "#C27A8E",
  "minimum": "#F1E3E7",
  "null": "#D6D0CB",
  "hyperlink": "#00613C",
  "visitedHyperlink": "#00613C",
  "textClasses": {
    "callout": {
      "fontSize": 30,
      "fontFace": "Segoe UI Bold",
      "color": "#7A0C2E"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#7A0C2E"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#231C1F"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#6E6468"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3DCD4"
              }
            },
            "radius": 12,
            "width": 1
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#3A0A18"
              }
            },
            "position": "Outer",
            "preset": "Custom",
            "shadowSpread": 0,
            "shadowBlur": 10,
            "angle": 90,
            "shadowDistance": 3,
            "transparency": 90
          }
        ],
        "padding": [
          {
            "top": 10,
            "bottom": 10,
            "left": 14,
            "right": 14
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#7A0C2E"
              }
            },
            "fontSize": 13,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left",
            "titleWrap": true
          }
        ],
        "visualHeader": [
          {
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "foreground": {
              "solid": {
                "color": "#6E6468"
              }
            },
            "border": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "visualTooltip": [
          {
            "titleFontColor": {
              "solid": {
                "color": "#7A0C2E"
              }
            },
            "valueFontColor": {
              "solid": {
                "color": "#231C1F"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#6E6468"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#6E6468"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": false,
            "fontFamily": "Segoe UI"
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#6E6468"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#6E6468"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#ECE6DF"
              }
            },
            "gridlineStyle": "solid",
            "fontFamily": "Segoe UI"
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#231C1F"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#6E6468"
              }
            },
            "fontFamily": "Segoe UI",
            "position": "Top"
          }
        ],
        "lineStyles": [
          {
            "strokeWidth": 3
          }
        ],
        "wordWrap": [
          {
            "show": true
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#231C1F"
              }
            },
            "transparency": 0,
            "border": true,
            "borderColor": {
              "solid": {
                "color": "#E3DCD4"
              }
            }
          }
        ],
        "filterCard": [
          {
            "$id": "Applied",
            "transparency": 0,
            "backgroundColor": {
              "solid": {
                "color": "#F8F1F3"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#231C1F"
              }
            },
            "border": true,
            "borderColor": {
              "solid": {
                "color": "#E3DCD4"
              }
            }
          },
          {
            "$id": "Available",
            "transparency": 0,
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#231C1F"
              }
            },
            "border": true,
            "borderColor": {
              "solid": {
                "color": "#E3DCD4"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F1EC"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#E8E2DA"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#7A0C2E"
              }
            },
            "fontSize": 30,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#6E6468"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI"
          }
        ],
        "title": [
          {
            "alignment": "center",
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#6E6468"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#7A0C2E"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "outline": "None",
            "alignment": "Left"
          }
        ],
        "values": [
          {
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F8F2F3"
              }
            },
            "fontColorPrimary": {
              "solid": {
                "color": "#231C1F"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#231C1F"
              }
            },
            "fontFamily": "Segoe UI",
            "outline": "None"
          }
        ],
        "total": [
          {
            "backColor": {
              "solid": {
                "color": "#EFE3E7"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#7A0C2E"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EEE6E8"
              }
            },
            "gridHorizontalWeight": 1,
            "gridVertical": false,
            "outlineColor": {
              "solid": {
                "color": "#E3DCD4"
              }
            },
            "rowPadding": 4
          }
        ]
      }
    },
    "pieChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "RightCenter"
          }
        ],
        "labels": [
          {
            "labelStyle": "Data value, percent of total",
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "slices": [
          {
            "innerRadiusRatio": 0
          }
        ]
      }
    },
    "scatterChart": {
      "*": {
        "bubbles": [
          {
            "bubbleSize": -10,
            "markerRangeType": "auto"
          }
        ],
        "fillPoint": [
          {
            "show": true
          }
        ]
      }
    },
    "map": {
      "*": {
        "bubbles": [
          {
            "bubbleSize": -10,
            "markerRangeType": "auto"
          }
        ],
        "dataPoint": [
          {
            "defaultColor": {
              "solid": {
                "color": "#7A0C2E"
              }
            }
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "shape": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    }
  }
}