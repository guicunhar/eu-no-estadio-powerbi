		sourceColumn: [id_gol]

		annotation SummarizationSetBy = Automatic

	partition Participacoes = calculated
		mode: import
		source =
				
				UNION(
				    SELECTCOLUMNS(
				        Gols,
				        "id_gol",Gols[id_gol],
				        "id_jogo", Gols[id_jogo],
				        "id_jogador", Gols[id_autor],
				        "tipo", "Gol"
				    ),
				    SELECTCOLUMNS(
				        Gols,
				        "id_gol",Gols[id_gol],
				        "id_jogo", Gols[id_jogo],
				        "id_jogador", Gols[id_ass],
				        "tipo", "Assist"
				    )
				)

	annotation PBI_Id = 6eb898d9508a4f79813b242c753c90e5

