	column tempo
		dataType: int64
		formatString: 0
		lineageTag: 110eef06-cee2-45fe-911d-0030b04ad91f
		summarizeBy: none
		sourceColumn: tempo

		annotation SummarizationSetBy = User

	partition Gols = m
		mode: import
		source =
				let
				    Fonte = Excel.Workbook(Web.Contents("https://docs.google.com/spreadsheets/d/1qgf1kaFvj2xq7Lq8sWT8C-a_aUbKhLPuf25QtFDOHUc/export"), null, true),
				    Gols_Sheet = Fonte{[Item="Gols",Kind="Sheet"]}[Data],
				    #"Cabeçalhos Promovidos" = Table.PromoteHeaders(Gols_Sheet, [PromoteAllScalars=true]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Cabeçalhos Promovidos",{{"id_gol", Int64.Type}, {"id_jogo", Int64.Type}, {"id_autor", Int64.Type}, {"autor_gol", type text}, {"id_ass", Int64.Type}, {"assistencia", type text}, {"tempo", Int64.Type}}),
				    #"Linhas em Branco Removidas" = Table.SelectRows(#"Tipo Alterado", each not List.IsEmpty(List.RemoveMatchingItems(Record.FieldValues(_), {"", null})))
				in
				    #"Linhas em Branco Removidas"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

