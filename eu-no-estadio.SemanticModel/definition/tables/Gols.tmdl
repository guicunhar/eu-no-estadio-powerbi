table Gols
	lineageTag: eb481e59-61f2-4e8f-8a8c-fd4e3dfb59ce

	measure 'Total Gols' =
			
			COUNT('Gols'[id_gol])
		formatString: 0
		lineageTag: 23116d27-ef4c-4a3c-ae95-2fa37a701c0b

	measure 'Tempo do Gol' =
			
			COUNT('Gols'[tempo])
		formatString: 0
		lineageTag: 0b9c162e-8a3c-45d2-9b7d-a0ac8369df1b

	measure Gols =
			CALCULATE(
				COUNTA('Gols'[autor_gol]),
				FILTER(
					ALLSELECTED('Jogos'[Data]),
					ISONORAFTER('Jogos'[Data], MAX('Jogos'[Data]), DESC)
				)
			)
		formatString: 0
		lineageTag: 3b3f3790-b1b3-4ea3-8890-4f13e6eeb046

	measure Assistência =
			CALCULATE(
				COUNTA('Gols'[assistencia]),
				FILTER(
					ALLSELECTED('Jogos'[Data]),
					ISONORAFTER('Jogos'[Data], MAX('Jogos'[Data]), DESC)
				)
			)
		formatString: 0
		lineageTag: 2fc5e709-a030-4edc-ba52-808f1d59d887

	column id_gol
		dataType: int64
		formatString: 0
		lineageTag: 36d0bd7f-d9b6-4509-aed8-26547037313c
		summarizeBy: none
		sourceColumn: id_gol

		annotation SummarizationSetBy = User

	column id_jogo
