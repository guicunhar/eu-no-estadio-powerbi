		formatString: 0
		lineageTag: 6e41de17-cf05-4607-ab94-c373dd095275
		summarizeBy: none
		sourceColumn: id_jogo

		annotation SummarizationSetBy = Automatic

	column id_autor
		dataType: int64
		formatString: 0
		lineageTag: c5cc7370-4c4b-4a64-a10c-d23d5a2ceaf9
		summarizeBy: none
		sourceColumn: id_autor

		annotation SummarizationSetBy = Automatic

	column autor_gol
		dataType: string
		lineageTag: 9d06c8fd-4301-4328-8cbe-7275c052bac6
		summarizeBy: none
		sourceColumn: autor_gol

		annotation SummarizationSetBy = Automatic

	column id_ass
		dataType: int64
		formatString: 0
		lineageTag: 0c7b6550-e867-4705-83d1-545295b82f08
		summarizeBy: none
		sourceColumn: id_ass

		annotation SummarizationSetBy = Automatic

	column assistencia
		dataType: string
		lineageTag: 77bc0ff0-c32c-40db-80c8-51187aeb0933
