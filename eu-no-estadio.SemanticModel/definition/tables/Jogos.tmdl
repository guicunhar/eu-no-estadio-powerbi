	column Resultado = ```
			
			SWITCH(
			    TRUE(),
			    Jogos[gols_flu] > Jogos[gols_adv], "V",
			    Jogos[gols_flu] < Jogos[gols_adv], "D",
			    "E"
			)
			
			```
		lineageTag: a4a23c0c-2ebf-4517-b454-de89834a3b20
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Resultado Exato' =
			
			Jogos[gols_flu] & " x " & Jogos[gols_adv]
		lineageTag: 1d3c103a-829d-4920-a34f-bbb729a8768c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Dia da Semana' =
			
