table Jogos
	lineageTag: 72137b9b-ca17-4b8f-abc0-e5d0b218d091

	measure 'Total de Jogos' = DISTINCTCOUNT(Jogos[id_jogo])
		formatString: 0
		lineageTag: 353ad531-665e-435c-a2cf-6234f3d4c837

	measure Aproveitamento = ```
			
			DIVIDE(
			    CALCULATE(
			        SUMX(
			            Jogos,
			            SWITCH(
			                Jogos[Resultado],
			                "V", 3,
			                "E", 1,
			                0
			            )
			        )
			    ),
			    3 * [Total de Jogos]
			)
			
			```
		lineageTag: 22348327-d849-4f6c-bcab-df2b766275f8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Média de Gols do Flu por Jogo' = SUM(Jogos[gols_flu])/[Total de Jogos]
		lineageTag: f57ccf06-0ebf-4012-a5df-82820fa130ff

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Média de Gols dos Adversários por Jogo' = SUM(Jogos[gols_adv])/[Total de Jogos]
		lineageTag: 170a0d8d-c6b7-4c85-89d5-fe5e445eac89

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Placar = ```
			
			COUNT(Jogos[Resultado Exato])
			
			```
		formatString: 0
		lineageTag: 6024401b-b33c-4ecb-bab6-492ac3ed1af4

	measure 'Total por Estádio' =
			
			CALCULATE(
				COUNTA('Jogos'[estadio]),
				FILTER(
					ALLSELECTED('Jogos'[Data]),
					ISONORAFTER('Jogos'[Data], MAX('Jogos'[Data]), DESC)
				)
			)
		formatString: 0
		lineageTag: 58266bd1-530f-4fde-809d-63a15a23932f

