	column Local_Mapa = ```
			IF(
			    LEN('Adversários'[local_adv]) = 2,
			    'Adversários'[cidade_adv] & ", " & 'Adversários'[local_adv] & ", Brasil",
			    'Adversários'[cidade_adv] & ", " & 'Adversários'[local_adv]
			)
			
			```
		lineageTag: 54381d0c-f36e-4742-a68d-67eb1d53fd9e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Local = ```
			
			IF(
			LEN(TRIM('Adversários'[local_adv])) = 3,
			'Adversários'[local_adv],
			'Adversários'[local_adv] & "-BRA"
			)
			
			```
		lineageTag: fd32597a-6c10-46ae-8ad8-6130fa3530ac
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Pais =
			
			IF(
			    LEN(TRIM('Adversários'[local_adv])) = 2,
			    "BRA",
			    TRIM('Adversários'[local_adv])
			)
		lineageTag: c4a761db-8f28-4273-ae8f-9c33bf1fc771
